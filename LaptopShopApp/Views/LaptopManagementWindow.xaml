<Window x:Class="LaptopShopApp.Views.LaptopManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop Management" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,0">
            <Grid>
                <TextBlock Text="Laptop Management" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnAdd" 
                       Content="➕ Add Laptop" 
                       Width="120"
                       Height="35"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnAdd_Click"
                       Cursor="Hand"
                       Margin="0,0,10,0"/>
                
                <Button x:Name="BtnEdit" 
                       Content="✏️ Edit" 
                       Width="100"
                       Height="35"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnEdit_Click"
                       Cursor="Hand"
                       Margin="0,0,10,0"/>
                
                <Button x:Name="BtnDelete" 
                       Content="🗑️ Delete" 
                       Width="100"
                       Height="35"
                       Background="#F44336"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnDelete_Click"
                       Cursor="Hand"
                       Margin="0,0,10,0"/>
                
                <Button Content="🔄 Refresh" 
                       Width="100"
                       Height="35"
                       Background="#2196F3"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnRefresh_Click"
                       Cursor="Hand"/>
            </StackPanel>

            <!-- Data Grid -->
            <DataGrid Grid.Row="1" 
                     x:Name="DgLaptops"
                     AutoGenerateColumns="False"
                     SelectionMode="Single"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     AlternatingRowBackground="#F5F5F5"
                     GridLinesVisibility="None"
                     HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding LaptopID}" Width="50"/>
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="100"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="150"/>
                    <DataGridTextColumn Header="Processor" Binding="{Binding Processor}" Width="150"/>
                    <DataGridTextColumn Header="RAM" Binding="{Binding RAM}" Width="80"/>
                    <DataGridTextColumn Header="Storage" Binding="{Binding Storage}" Width="80"/>
                    <DataGridTextColumn Header="GPU" Binding="{Binding GPU}" Width="120"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0:N0} VND'}" Width="120"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Form Panel -->
            <Border Grid.Row="2" 
                   Background="White" 
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1"
                   Padding="20"
                   Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                        <TextBlock Text="Brand:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtBrand" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,0">
                        <TextBlock Text="Model:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtModel" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,0">
                        <TextBlock Text="Processor:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtProcessor" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,10,10,0">
                        <TextBlock Text="RAM:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtRAM" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,10,10,0">
                        <TextBlock Text="Storage:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtStorage" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="GPU:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtGPU" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,10,10,0">
                        <TextBlock Text="Price (VND):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtPrice" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,10,10,0">
                        <TextBlock Text="Stock:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtStock" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="2" Grid.RowSpan="2" Margin="0,10,0,0">
                        <TextBlock Text="Description:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtDescription" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="💾 Save" 
                               Width="100"
                               Height="35"
                               Background="#4CAF50"
                               Foreground="White"
                               BorderThickness="0"
                               FontWeight="Bold"
                               Click="BtnSave_Click"
                               Cursor="Hand"
                               Margin="0,0,10,0"/>
                        
                        <Button Content="❌ Clear" 
                               Width="100"
                               Height="35"
                               Background="#757575"
                               Foreground="White"
                               BorderThickness="0"
                               FontWeight="Bold"
                               Click="BtnClear_Click"
                               Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

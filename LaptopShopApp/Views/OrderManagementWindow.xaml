<Window x:Class="LaptopShopApp.Views.OrderManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Management" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF9800" Padding="20,0">
            <Grid>
                <TextBlock Text="Order Management" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnAdd" 
                       Content="➕ New Order" 
                       Width="120"
                       Height="35"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnAdd_Click"
                       Cursor="Hand"
                       Margin="0,0,10,0"/>
                
                <Button x:Name="BtnViewDetails" 
                       Content="📄 View Details" 
                       Width="120"
                       Height="35"
                       Background="#2196F3"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnViewDetails_Click"
                       Cursor="Hand"
                       Margin="0,0,10,0"/>
                
                <Button Content="🔄 Refresh" 
                       Width="100"
                       Height="35"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnRefresh_Click"
                       Cursor="Hand"/>
            </StackPanel>

            <!-- Data Grid -->
            <DataGrid Grid.Row="1" 
                     x:Name="DgOrders"
                     AutoGenerateColumns="False"
                     SelectionMode="Single"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     AlternatingRowBackground="#F5F5F5"
                     GridLinesVisibility="None"
                     HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order ID" Binding="{Binding OrderID}" Width="80"/>
                    <DataGridTextColumn Header="Customer ID" Binding="{Binding CustomerID}" Width="100"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150"/>
                    <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} VND'}" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Form Panel -->
            <Border Grid.Row="2" 
                   Background="White" 
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1"
                   Padding="20"
                   Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                        <TextBlock Text="Customer ID:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCustomerID" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,0">
                        <TextBlock Text="Total Amount (VND):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTotalAmount" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,0">
                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbStatus" Height="30">
                            <ComboBoxItem Content="Pending" IsSelected="True"/>
                            <ComboBoxItem Content="Processing"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Cancelled"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,10,0">
                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNotes" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Margin="0,35,0,0" HorizontalAlignment="Right">
                        <Button Content="💾 Save" 
                               Width="100"
                               Height="35"
                               Background="#4CAF50"
                               Foreground="White"
                               BorderThickness="0"
                               FontWeight="Bold"
                               Click="BtnSave_Click"
                               Cursor="Hand"
                               Margin="0,0,10,0"/>
                        
                        <Button Content="❌ Clear" 
                               Width="100"
                               Height="35"
                               Background="#757575"
                               Foreground="White"
                               BorderThickness="0"
                               FontWeight="Bold"
                               Click="BtnClear_Click"
                               Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

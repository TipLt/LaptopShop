<Window x:Class="LaptopShopApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop Shop - Dashboard" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LAPTOP SHOP MANAGEMENT" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="White"/>
                    <TextBlock x:Name="TxtUserInfo" 
                              FontSize="12" 
                              Foreground="#E3F2FD"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                       Content="Logout" 
                       Width="100"
                       Height="35"
                       Background="#FF5722"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="Bold"
                       Click="BtnLogout_Click"
                       Cursor="Hand"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Menu -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="MENU" 
                              FontSize="14" 
                              FontWeight="Bold" 
                              Margin="20,0,0,10"
                              Foreground="#666"/>

                    <Button x:Name="BtnLaptops" 
                           Content="📱 Laptop Management" 
                           Style="{StaticResource MenuButtonStyle}"
                           Click="BtnLaptops_Click"/>
                    
                    <Button x:Name="BtnOrders" 
                           Content="🛒 Order Management" 
                           Style="{StaticResource MenuButtonStyle}"
                           Click="BtnOrders_Click"/>
                    
                    <Button x:Name="BtnCustomers" 
                           Content="👥 Customer Management" 
                           Style="{StaticResource MenuButtonStyle}"
                           Click="BtnCustomers_Click"/>
                </StackPanel>
            </Border>

            <!-- Dashboard Content -->
            <Grid Grid.Column="1" Margin="20">
                <StackPanel>
                    <TextBlock Text="Dashboard" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              Margin="0,0,0,20"/>

                    <WrapPanel>
                        <Border Background="White" 
                               CornerRadius="5" 
                               Padding="20" 
                               Margin="0,0,20,20"
                               Width="200"
                               Height="120">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Total Laptops" 
                                          FontSize="14" 
                                          Foreground="#666"/>
                                <TextBlock x:Name="TxtTotalLaptops" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="#2196F3"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" 
                               CornerRadius="5" 
                               Padding="20" 
                               Margin="0,0,20,20"
                               Width="200"
                               Height="120">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Total Orders" 
                                          FontSize="14" 
                                          Foreground="#666"/>
                                <TextBlock x:Name="TxtTotalOrders" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="#FF9800"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" 
                               CornerRadius="5" 
                               Padding="20" 
                               Margin="0,0,20,20"
                               Width="200"
                               Height="120">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Total Customers" 
                                          FontSize="14" 
                                          Foreground="#666"/>
                                <TextBlock x:Name="TxtTotalCustomers" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="#4CAF50"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Welcome to Laptop Shop Management System" 
                              FontSize="16" 
                              Margin="0,20,0,10"/>
                    <TextBlock Text="Use the menu on the left to navigate to different sections." 
                              FontSize="14" 
                              Foreground="#666"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>

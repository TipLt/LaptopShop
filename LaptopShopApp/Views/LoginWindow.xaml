<Window x:Class="LaptopShopApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop Shop - Login" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2196F3" Offset="0"/>
                <GradientStop Color="#1976D2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White" 
                CornerRadius="10" 
                Padding="40"
                MaxWidth="400"
                MaxHeight="350"
                Margin="20">
            <StackPanel>
                <TextBlock Text="LAPTOP SHOP" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center"
                          Foreground="#2196F3"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Management System" 
                          FontSize="14" 
                          HorizontalAlignment="Center"
                          Foreground="#666666"
                          Margin="0,0,0,30"/>

                <TextBlock Text="Username:" 
                          FontSize="14" 
                          Margin="0,0,0,5"/>
                <TextBox x:Name="TxtUsername" 
                        Height="35" 
                        FontSize="14"
                        Padding="10,5"
                        Margin="0,0,0,15"/>

                <TextBlock Text="Password:" 
                          FontSize="14" 
                          Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" 
                            Height="35" 
                            FontSize="14"
                            Padding="10,5"
                            Margin="0,0,0,20"/>

                <Button x:Name="BtnLogin" 
                       Content="LOGIN" 
                       Height="40" 
                       FontSize="14"
                       FontWeight="Bold"
                       Background="#2196F3"
                       Foreground="White"
                       BorderThickness="0"
                       Click="BtnLogin_Click"
                       Cursor="Hand"
                       Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2196F3"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock x:Name="TxtMessage" 
                          Text="" 
                          Foreground="Red" 
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"/>

                <Separator Margin="0,15,0,15"/>
                
                <TextBlock TextWrapping="Wrap" 
                          FontSize="11" 
                          Foreground="#999999"
                          TextAlignment="Center">
                    Demo Accounts:
                    <LineBreak/>
                    admin/admin123 | sales1/sales123
                    <LineBreak/>
                    manager1/manager123 | warehouse1/warehouse123
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
